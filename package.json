    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
